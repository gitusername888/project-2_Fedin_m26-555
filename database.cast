[17.054003, "o", "e"]
[17.724947, "o", "\r\n"]
[17.72532, "o", "\u001b[?2004l\r"]
[17.788572, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись. \r\n<command> select from <имя_таблицы> where <столбец>= <значение> - прочитать записи по условию. \r\n<command> select from <имя_таблицы> - прочитать все записи.\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1>where <столбец_условия> = <значение_условия> - обновить запись.\r\n<command> delete from <имя_таблицы> where <столбец> = \r\n<значение> - удалить запись.\r\n<command> info <имя_таблицы> - вывести информацию о таблице.\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[17.788952, "o", "> "]
[21.993322, "o", "create_table users name:str age:int is_active:bool"]
[23.395441, "o", "\r\n"]
[23.395819, "o", "Таблица \"users\" успешно создана со столбцами: [('ID', 'int'), ('name', 'str'), ('age', 'int'), ('is_active', 'bool')]\r\n> "]
